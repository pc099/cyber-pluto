# --- Pi fork (pi/pi is a git submodule as of Session 1 — see .gitmodules) ---
# The submodule itself is tracked via a gitlink + .gitmodules, not this
# ignore file. Ignore only its build output.
/pi/pi/node_modules/
/pi/pi/**/dist/

# --- TypeScript (extensions/) ---
node_modules/
dist/
build/
*.tsbuildinfo

# --- Python (services/) ---
__pycache__/
*.pyc
*.pyo
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Secrets — never commit ---
.env
.env.*
*.key
*.pem
secrets/
credentials.json
*credentials*.json

# --- Pluto runtime state / evidence ---
# The whole state dir is runtime data (SQLite db + WAL/shm sidecars).
/state/
evidence/
logs/

# --- Pi runtime config/session state (project-local, created on first run) ---
/.pi/

# --- OS / editor ---
.DS_Store
*.swp
.vscode/
.idea/
