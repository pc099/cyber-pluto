#!/usr/bin/env bash
#
# cyberpluto — thin dispatcher to the typed Pluto launcher.
#
# Pluto is a SINGLE harness, not a bash wrapper: the extension stack, the
# runtime-skill catalog, and the reasoning defaults are defined declaratively in
# `.pi/settings.json` and loaded by Pi itself (trusted with -a). All engagement
# logic — scope resolution, the per-engagement briefing, caps, provider/phase
# routing, interactive vs --headless — lives in the typed, unit-tested launcher
# at extensions/src/launcher/. This file only locates the repo and hands off.
#
# Run it inside tmux for persistence. `cyberpluto --help` for all options.
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$SCRIPT_DIR"

LAUNCHER="extensions/dist/launcher/index.js"
if [[ ! -f "$LAUNCHER" ]]; then
  echo "[cyberpluto] building launcher…" >&2
  ( cd extensions && npm run build >/dev/null 2>&1 ) || { echo "extension build failed — run 'cd extensions && npm run build'." >&2; exit 1; }
fi

exec node "$LAUNCHER" "$@"
